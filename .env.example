# ─────────────────────────────────────────────
# Youth Access Hub — Environment Variables
# Copy this file to .env.local and fill in values
# NEVER commit .env.local
# ─────────────────────────────────────────────

# ── Supabase (required) ───────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ── Revalidation secret ───────────────────────
# A random string used to authenticate on-demand ISR revalidation.
# Must match NEXT_PUBLIC_REVALIDATE_SECRET exactly.
# Generate one: openssl rand -base64 32


# ── Email / Contact Form (Phase 2+) ──────────
RESEND_API_KEY=
CONTACT_EMAIL_TO=